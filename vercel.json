{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/site?route=/"
    },
    {
      "source": "/home-page",
      "destination": "/api/site?route=/home-page"
    },
    {
      "source": "/zero-fee-inquiry",
      "destination": "/api/site?route=/zero-fee-inquiry"
    },
    {
      "source": "/zero-fee-thank-you",
      "destination": "/api/site?route=/zero-fee-thank-you"
    },
    {
      "source": "/privacy",
      "destination": "/api/site?route=/privacy"
    },
    {
      "source": "/api/lead",
      "destination": "/api/site?route=/api/lead"
    },
    {
      "source": "/api/form-token",
      "destination": "/api/site?route=/api/form-token"
    },
    {
      "source": "/zerofee",
      "destination": "/api/site?route=/zerofee"
    },
    {
      "source": "/zerofee/inquiry",
      "destination": "/api/site?route=/zerofee/inquiry"
    },
    {
      "source": "/zerofee/thank-you",
      "destination": "/api/site?route=/zerofee/thank-you"
    },
    {
      "source": "/boarding",
      "destination": "/api/site?route=/boarding"
    },
    {
      "source": "/boarding/review",
      "destination": "/api/site?route=/boarding/review"
    },
    {
      "source": "/api/boarding/:action",
      "destination": "/api/site?route=/api/boarding/:action"
    },
    {
      "source": "/statement-analyzer",
      "destination": "/api/site?route=/statement-analyzer"
    },
    {
      "source": "/api/statement/:action",
      "destination": "/api/site?route=/api/statement/:action"
    },
    {
      "source": "/pos-center",
      "destination": "/api/site?route=/pos-center"
    }
  ],
  "functions": {
    "api/site.js": {
      "maxDuration": 180
    }
  }
}
